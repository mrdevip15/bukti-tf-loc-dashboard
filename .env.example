TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-private-or-group-chat-id
# SHA-256 of the complete forwarded Basic Authorization header, including the "Basic " prefix.
# Example generator: printf 'Basic %s' "$(printf 'username:password' | base64)" | sha256sum
ADMIN_AUTH_SHA256=replace-with-64-character-sha256
PORT=3000
HOST=0.0.0.0
